{
  "type": "minecraft:confirmation",
  "title": [
    {
      "translate": "title.i-editor.component",
      "fallback": "Component"
    },
    ": ",
    {
      "translate": "component.i-editor.base_color",
      "fallback": "Base Color",
      "color": "yellow"
    }
  ],
  "external_title": {
    "translate": "component.i-editor.base_color",
    "fallback": "Base Color"
  },
  "body": {
    "type": "minecraft:item",
