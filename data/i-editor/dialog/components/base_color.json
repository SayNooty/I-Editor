  "inputs": [
    {
      "type": "minecraft:single_option",
      "key": "color",
      "label": {
        "translate": "subtitle.i-editor.color",
        "fallback": "Color"
      },
      "options": [
        {
          "id": "white",
          "display": {
            "translate": "color.minecraft.white",
            "color": "#ffffff"
          }
        },
        {
          "id": "light_gray",
          "display": {
