{
  "type": "minecraft:confirmation",
  "title": [
    {
      "translate": "title.i-editor.component",
      "fallback": "Component"
    },
    ": ",
    {
      "translate": "component.i-editor.entity_variant",
      "fallback": "Entity Variant",
      "color": "yellow"
    },
    " ",
    {
      "text": "|",
      "color": "gray"
    },
    " ",
    {
      "translate": "entity.minecraft.wolf",
      "color": "gold"
    }
  ],
  "external_title": [
    {
      "atlas": "minecraft:items",
      "sprite": "minecraft:item/wolf_spawn_egg"
    },
    " ",
    {
    "translate": "entity.minecraft.wolf"
    }
  ],
  "body": {
    "type": "minecraft:item",
    "item": {
      "id": "minecraft:wolf_spawn_egg"
    },
    "description": {
      "translate": "description.i-editor.component.entity_variants.entity",
      "fallback": "Select the variant that you want to apply to the spawn egg of this entity:",
      "color": "gray"
    },
    "show_decorations": false,
    "show_tooltip": false
  },
  "inputs": [
    {
      "type": "minecraft:single_option",
      "key": "variant",
      "label": {
        "translate": "subtitle.i-editor.variant",
        "fallback": "Variant"
      },
      "options": [
        {
          "id": "ashen",
          "display": {
            "translate": "variant.i-editor.ashen",
            "fallback": "Ashen"
          }
        },
        {
          "id": "black",
          "display": {
            "translate": "variant.i-editor.black",
            "fallback": "Black"
          }
        },
        {
          "id": "chestnut",
          "display": {
            "translate": "variant.i-editor.chestnut",
            "fallback": "Chestnut"
          }
        },
        {
          "id": "pale",
          "display": {
            "translate": "variant.i-editor.pale",
            "fallback": "Pale"
          }
        },
        {
          "id": "rusty",
          "display": {
            "translate": "variant.i-editor.rusty",
            "fallback": "Rusty"
          }
        },
        {
          "id": "snowy",
          "display": {
            "translate": "variant.i-editor.snow",
            "fallback": "Snow"
          }
        },
        {
          "id": "spotted",
          "display": {
            "translate": "variant.i-editor.spotted",
            "fallback": "Spotted"
          }
        },
        {
          "id": "striped",
          "display": {
            "translate": "variant.i-editor.striped",
            "fallback": "Striped"
          }
        },
        {
          "id": "woods",
          "display": {
            "translate": "variant.i-editor.woods",
            "fallback": "Woods"
          }
        }
      ]
    }
  ],
  "can_close_with_escape": true,
  "pause": false,
  "after_action": "none",
  "yes": {
    "label": {
      "translate": "gui.done",
      "color": "green"
    },
    "action": {
      "type": "dynamic/run_command",
      "template": "execute if items entity @s weapon.mainhand * run item modify entity @s weapon.mainhand {\"type\":\"minecraft:set_components\",\"components\":{\"minecraft:wolf/variant\":\"$(variant)\"}}"
    }
  },
  "no": {
    "label": {
      "translate": "gui.back",
      "color": "red"
    },
    "action": {
      "type": "show_dialog",
      "dialog": "i-editor:components/entity_variant"
    }
  }
}