{
  "type": "minecraft:confirmation",
  "title": [
    {
      "translate": "title.i-editor.component",
      "fallback": "Component"
    },
    ": ",
    {
      "translate": "component.i-editor.entity_variant",
      "fallback": "Entity Variant",
      "color": "yellow"
    },
    " ",
    {
      "text": "|",
      "color": "gray"
    },
    " ",
    {
      "translate": "entity.minecraft.pig",
      "color": "gold"
    }
  ],
  "external_title": [
    {
      "atlas": "minecraft:items",
      "sprite": "minecraft:item/pig_spawn_egg"
    },
    " ",
    {
    "translate": "entity.minecraft.pig"
    }
  ],
  "body": {
    "type": "minecraft:item",
    "item": {
      "id": "minecraft:pig_spawn_egg"
    },
    "description": {
      "translate": "description.i-editor.component.entity_variant.entity",
      "fallback": "Select the variant that you want to apply to the spawn egg of this entity:",
      "color": "gray"
    },
    "show_decorations": false,
    "show_tooltip": false
  },
  "inputs": [
    {
      "type": "minecraft:single_option",
      "key": "variant",
      "label": {
        "translate": "subtitle.i-editor.variant",
        "fallback": "Variant"
      },
      "options": [
        {
          "id": "temperate",
          "display": {
            "translate": "variant.i-editor.temperate",
            "fallback": "Temperate"
          },
          "initial": true
        },
        {
          "id": "cold",
          "display": {
            "translate": "variant.i-editor.cold",
            "fallback": "Cold"
          }
        },
        {
          "id": "warm",
          "display": {
            "translate": "variant.i-editor.warm",
            "fallback": "Warm"
          }
        }
      ]
    }
  ],
  "can_close_with_escape": true,
  "pause": false,
  "after_action": "none",
  "yes": {
    "label": {
      "translate": "gui.done",
      "color": "green"
    },
    "action": {
      "type": "dynamic/run_command",
      "template": "execute if items entity @s weapon.mainhand * run item modify entity @s weapon.mainhand {\"type\":\"minecraft:set_components\",\"components\":{\"minecraft:pig/variant\":\"$(variant)\"}}"
    }
  },
  "no": {
    "label": {
      "translate": "gui.back",
      "color": "red"
    },
    "action": {
      "type": "show_dialog",
      "dialog": "i-editor:components/entity_variant"
    }
  }
}