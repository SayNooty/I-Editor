{
  "type": "minecraft:confirmation",
  "title": [
    {
      "translate": "title.i-editor.component",
      "fallback": "Component"
    },
    ": ",
    {
      "translate": "component.i-editor.entity_variant",
      "fallback": "Entity Variant",
      "color": "yellow"
    },
    " ",
    {
      "text": "|",
      "color": "gray"
    },
    " ",
    {
      "translate": "entity.minecraft.horse",
      "color": "gold"
    }
  ],
  "external_title": [
    {
      "atlas": "minecraft:items",
      "sprite": "minecraft:item/horse_spawn_egg"
    },
    " ",
    {
    "translate": "entity.minecraft.horse"
    }
  ],
  "body": {
    "type": "minecraft:item",
    "item": {
      "id": "minecraft:horse_spawn_egg"
    },
    "description": {
      "translate": "description.i-editor.component.entity_variant.entity",
      "fallback": "Select the variant that you want to apply to the spawn egg of this entity:",
      "color": "gray"
    },
    "show_decorations": false,
    "show_tooltip": false
  },
  "inputs": [
    {
      "type": "minecraft:single_option",
      "key": "variant",
      "label": {
        "translate": "subtitle.i-editor.variant",
        "fallback": "Variant"
      },
      "options": [
        {
          "id": "white",
          "display": {
            "translate": "variant.i-editor.white",
            "fallback": "White"
          }
        },
        {
          "id": "creamy",
          "display": {
            "translate": "variant.i-editor.creamy",
            "fallback": "Creamy"
          }
        },
        {
          "id": "chestnut",
          "display": {
            "translate": "variant.i-editor.chestnut",
            "fallback": "Chestnut"
          }
        },
        {
          "id": "brown",
          "display": {
            "translate": "variant.i-editor.brown",
            "fallback": "Brown",
            "color": "#835432"
          }
        },
        {
          "id": "black",
          "display": {
            "translate": "variant.i-editor.black",
            "fallback": "Black",
            "color": "black"
          }
        },
        {
          "id": "gray",
          "display": {
            "translate": "variant.i-editor.gray",
            "fallback": "Gray",
            "color": "gray"
          }
        },
        {
          "id": "dark_brown",
          "display": {
            "translate": "variant.i-editor.dark_brown",
            "fallback": "Dark Brown"
          }
        }
      ]
    }
  ],
  "can_close_with_escape": true,
  "pause": false,
  "after_action": "none",
  "yes": {
    "label": {
      "translate": "gui.done",
      "color": "green"
    },
    "action": {
      "type": "dynamic/run_command",
      "template": "execute if items entity @s weapon.mainhand * run item modify entity @s weapon.mainhand {\"type\":\"minecraft:set_components\",\"components\":{\"minecraft:horse/variant\":\"$(variant)\"}}"
    }
  },
  "no": {
    "label": {
      "translate": "gui.back",
      "color": "red"
    },
    "action": {
      "type": "show_dialog",
      "dialog": "i-editor:components/entity_variant"
    }
  }
}