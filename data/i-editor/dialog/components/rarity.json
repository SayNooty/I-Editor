{
  "type": "minecraft:confirmation",
  "title": [
    {
      "translate": "title.i-editor.component",
      "fallback": "Component"
    },
    ": ",
    {
      "translate": "component.i-editor.rarity",
      "fallback": "Rarity",
      "color": "yellow"
    }
  ],
  "external_title": [
    {
      "atlas": "minecraft:items",
      "sprite": "minecraft:item/nether_star"
    },
    " ",
    {
    "translate": "component.i-editor.rarity",
    "fallback": "Rarity"
    }
  ],
  "body": {
    "type": "minecraft:item",
    "item": {
      "id": "minecraft:nether_star"
    },
    "description": {
      "translate": "description.i-editor.component.rarity",
      "fallback": "Select the rarity that will be applied to the item:",
      "color": "gray"
    },
    "show_decorations": false,
    "show_tooltip": false
  },
  "inputs": [
    {
      "type": "minecraft:single_option",
      "key": "rarity",
      "label": {
        "translate": "subtitle.i-editor.rarity",
        "fallback": "Rarity"
      },
      "options": [
        {
          "id": "common",
          "display": {
            "translate": "rarity.i-editor.common",
            "fallback": "Common"
          }
        },
        {
          "id": "uncommon",
          "display": {
            "translate": "rarity.i-editor.uncommon",
            "fallback": "Uncommon",
            "color": "yellow"
          }
        },
        {
          "id": "rare",
          "display": {
            "translate": "rarity.i-editor.rare",
            "fallback": "Rare",
            "color": "aqua"
          }
        },
        {
          "id": "epic",
          "display": {
            "translate": "rarity.i-editor.epic",
            "fallback": "Epic",
            "color": "light_purple"
          }
        }
      ]
    }
  ],
  "can_close_with_escape": true,
  "pause": false,
  "after_action": "none",
  "yes": {
    "label": {
      "translate": "gui.done",
      "color": "green"
    },
    "action": {
      "type": "dynamic/run_command",
      "template": "execute if items entity @s weapon.mainhand * run item modify entity @s weapon.mainhand {\"type\":\"minecraft:set_components\",\"components\":{\"minecraft:rarity\":\"$(rarity)\"}}"
    }
  },
  "no": {
    "label": {
      "translate": "gui.back",
      "color": "red"
    },
    "action": {
      "type": "show_dialog",
      "dialog": "i-editor:set_component"
    }
  }
}