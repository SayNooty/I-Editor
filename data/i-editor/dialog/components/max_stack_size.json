{
  "type": "minecraft:confirmation",
  "title": [
    {
      "translate": "title.i-editor.component",
      "fallback": "Component"
    },
    ": ",
    {
      "translate": "component.i-editor.max_stack_size",
      "fallback": "Max Stack Size",
      "color": "yellow"
    }
  ],
  "external_title": [
    {
      "atlas": "minecraft:items",
      "sprite": "minecraft:item/egg"
    },
    " ",
    {
    "translate": "component.i-editor.max_stack_size",
    "fallback": "Max Stack Size"
    }
  ],
  "body": {
    "type": "minecraft:item",
    "item": {
      "id": "minecraft:egg"
    },
    "description": {
      "translate": "description.i-editor.component.max_stack_size",
      "fallback": "Select the maximum stack size in one slot:",
      "color": "gray"
    },
    "show_decorations": false
  },
  "inputs": [
    {
      "type": "minecraft:number_range",
      "key": "count",
      "label": {
        "translate": "subtitle.i-editor.count",
        "fallback": "Count"
      },
      "start": 1,
      "end": 99,
      "step": 1,
      "initial": 64
    }
  ],
  "can_close_with_escape": true,
  "pause": false,
  "after_action": "none",
  "yes": {
    "label": {
      "translate": "gui.done",
      "color": "green"
    },
    "action": {
      "type": "dynamic/run_command",
      "template": "execute if items entity @s weapon.mainhand * run item modify entity @s weapon.mainhand {\"type\":\"minecraft:set_components\",\"components\":{\"minecraft:max_stack_size\":$(count)}}"
    }
  },
  "no": {
    "label": {
      "translate": "gui.back",
      "color": "red"
    },
    "action": {
      "type": "show_dialog",
      "dialog": "i-editor:set_component"
    }
  }
}