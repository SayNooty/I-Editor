{
  "type": "minecraft:confirmation",
  "title": [
    {
      "translate": "title.i-editor.component",
      "fallback": "Component"
    },
    ": ",
    {
      "translate": "component.i-editor.lodestone_tracker",
      "fallback": "Lodestone Tracker",
      "color": "yellow"
    }
  ],
  "external_title": [
    {
      "atlas": "minecraft:items",
      "sprite": "minecraft:item/compass_00"
    },
    " ",
    {
    "translate": "component.i-editor.lodestone_tracker",
    "fallback": "Lodestone Tracker"
    }
  ],
  "body": {
    "type": "minecraft:item",
    "item": {
      "id": "minecraft:compass",
      "components": {
        "minecraft:enchantment_glint_override": true
      }
    },
    "description": {
      "translate": "description.i-editor.component.lodestone_tracker",
      "fallback": "Enter the coordinates and dimension to which the compass will point:",
      "color": "gray"
    },
    "show_decorations": false,
    "show_tooltip": false
  },
  "inputs": [
    {
      "type": "minecraft:text",
      "key": "pos_xyz",
      "width": 150,
      "label": [
        {
          "translate": "subtitle.i-editor.pos",
          "fallback": "Pos"
        },
        " ",
        {
          "text": "<x, y, z>",
          "color": "dark_gray"
        }
      ],
      "initial": "0, 0, 0",
      "max_length": 9999
    },
    {
      "type": "minecraft:single_option",
      "key": "dimension",
      "width": 150,
      "label": {
        "translate": "subtitle.i-editor.dimension",
        "fallback": "Dimension"
      },
      "options": [
        {
          "id": "overworld",
          "display": {
            "translate": "world.i-editor.overworld",
            "fallback": "Overworld",
            "color": "green"
          }
        },
        {
          "id": "the_nether",
          "display": {
            "translate": "world.i-editor.nether",
            "fallback": "Nether",
            "color": "red"
          }
        },
        {
          "id": "the_end",
          "display": {
            "translate": "world.i-editor.end",
            "fallback": "End",
            "color": "light_purple"
          }
        }
      ]
    },
    {
      "type": "minecraft:boolean",
      "key": "tracked",
      "label": {
        "translate": "subtitle.i-editor.tracked",
        "fallback": "Tracked"
      },
      "initial": true
    }
  ],
  "can_close_with_escape": true,
  "pause": false,
  "after_action": "none",
  "yes": {
    "label": {
      "translate": "gui.done",
      "color": "green"
    },
    "action": {
      "type": "dynamic/run_command",
      "template": "execute if items entity @s weapon.mainhand * run item modify entity @s weapon.mainhand {\"type\":\"minecraft:set_components\",\"components\":{\"minecraft:lodestone_tracker\":{target:{pos:[$(pos_xyz)],dimension:\"$(dimension)\"},tracked:$(tracked)}}}"
    }
  },
  "no": {
    "label": {
      "translate": "gui.back",
      "color": "red"
    },
    "action": {
      "type": "show_dialog",
      "dialog": "i-editor:set_component"
    }
  }
}