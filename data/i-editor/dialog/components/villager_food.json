{
  "type": "minecraft:confirmation",
  "title": [
    {
      "translate": "title.i-editor.component",
      "fallback": "Component"
    },
    ": ",
    {
      "translate": "component.i-editor.villager_food",
      "fallback": "Villager Food",
      "color": "yellow"
    }
  ],
  "external_title": [
    {
      "atlas": "minecraft:items",
      "sprite": "minecraft:item/bread"
    },
    " ",
    {
    "translate": "component.i-editor.villager_food",
    "fallback": "Villager Food"
    }
  ],
  "body": {
    "type": "minecraft:item",
    "item": {
      "id": "minecraft:bread"
    },
    "description": {
      "translate": "description.i-editor.component.villager_food",
      "fallback": "Enter the saturation hunger value of the item for the villager:",
      "color": "gray"
    },
    "show_decorations": false,
    "show_tooltip": false
  },
  "inputs": [
    {
      "type": "minecraft:text",
      "key": "nutrition",
      "width": 100,
      "label": {
          "translate": "subtitle.i-editor.nutrition",
          "fallback": "Nutrition"
      }
    }
  ],
  "can_close_with_escape": true,
  "pause": false,
  "after_action": "none",
  "yes": {
    "label": {
      "translate": "gui.done",
      "color": "green"
    },
    "action": {
      "type": "dynamic/run_command",
      "template": "execute if items entity @s weapon.mainhand * run item modify entity @s weapon.mainhand {\"type\":\"minecraft:set_components\",\"components\":{\"minecraft:villager_food\":{\"nutrition\":$(nutrition)}}}"
    }
  },
  "no": {
    "label": {
      "translate": "gui.back",
      "color": "red"
    },
    "action": {
      "type": "show_dialog",
      "dialog": "i-editor:set_component"
    }
  }
}