{
  "type": "minecraft:confirmation",
  "title": [
    {
      "translate": "title.i-editor.component",
      "fallback": "Component"
    },
    ": ",
    {
      "translate": "component.i-editor.sulfur_cube_content",
      "fallback": "Sulfur Cube Content",
      "color": "yellow"
    }
  ],
  "external_title": {
    "translate": "component.i-editor.sulfur_cube_content",
    "fallback": "Sulfur Cube Content"
  },
  "body": {
    "type": "minecraft:item",
    "item": {
      "id": "minecraft:sulfur_cube_spawn_egg"
    },
    "description": {
      "translate": "description.i-editor.component.sulfur_cube_content",
      "fallback": "Enter the block ID that will be inside the sulfur cube:",
      "color": "gray"
    },
    "show_decorations": false,
    "show_tooltip": false
  },
  "inputs": [
    {
      "type": "minecraft:text",
      "key": "block_id",
      "label": {
        "translate": "subtitle.i-editor.block_id",
        "fallback": "Block ID"
      },
      "initial": "minecraft:stone",
      "max_length": 9999
    }
  ],
  "can_close_with_escape": true,
  "pause": false,
  "after_action": "none",
  "yes": {
    "label": {
      "translate": "gui.done",
      "color": "green"
    },
    "action": {
      "type": "dynamic/run_command",
      "template": "execute if items entity @s weapon.mainhand * run item modify entity @s weapon.mainhand [{\"function\":\"minecraft:set_components\",\"components\":{\"minecraft:sulfur_cube_content\":\"$(block_id)\"}}]"
    }
  },
  "no": {
    "label": {
      "translate": "gui.back",
      "color": "red"
    },
    "action": {
      "type": "show_dialog",
      "dialog": "i-editor:set_component"
    }
  }
}