{
  "type": "minecraft:confirmation",
  "title": [
    {
      "translate": "title.i-editor.component",
      "fallback": "Component"
    },
    ": ",
    {
      "translate": "component.i-editor.cooking_fuel",
      "fallback": "Cooking Fuel",
      "color": "yellow"
    }
  ],
  "external_title": [
    {
      "atlas": "minecraft:items",
      "sprite": "minecraft:item/coal"
    },
    " ",
    {
      "translate": "component.i-editor.cooking_fuel",
      "fallback": "Cooking Fuel"
    }
  ],
  "body": {
    "type": "minecraft:item",
    "item": {
      "id": "minecraft:coal"
    },
    "description": {
      "translate": "description.i-editor.component.cooking_fuel",
      "fallback": "Enter the burning time and the cooking time of the item as fuel:",
      "color": "gray"
    },
    "show_decorations": false,
    "show_tooltip": false
  },
  "inputs": [
    {
      "type": "minecraft:text",
      "key": "burn_time",
      "width": 100,
      "label": [
        {
          "atlas": "minecraft:items",
          "sprite": "minecraft:item/clock_00"
        },
        " ",
        {
          "translate": "subtitle.i-editor.burn_time",
          "fallback": "Burn Time"
        }
      ]
    },
    {
      "type": "minecraft:text",
      "key": "speed_multiplier",
      "width": 100,
      "label": {
        "translate": "subtitle.i-editor.speed_multiplier",
        "fallback": "Speed Multiplier"
      }
    }
  ],
  "can_close_with_escape": true,
  "pause": false,
  "after_action": "none",
  "yes": {
    "label": {
      "translate": "gui.done",
      "color": "green"
    },
    "action": {
      "type": "dynamic/run_command",
      "template": "execute if items entity @s weapon.mainhand * run item modify entity @s weapon.mainhand {\"type\":\"minecraft:set_components\",\"components\":{\"minecraft:cooking_fuel\":{\"burn_time\":$(burn_time),\"speed_multiplier\":$(speed_multiplier)}}}"
    }
  },
  "no": {
    "label": {
      "translate": "gui.back",
      "color": "red"
    },
    "action": {
      "type": "show_dialog",
      "dialog": "i-editor:set_component"
    }
  }
}