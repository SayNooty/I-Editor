{
  "type": "minecraft:confirmation",
  "title": [
    {
      "translate": "title.i-editor.component",
      "fallback": "Component"
    },
    ": ",
    {
      "translate": "component.i-editor.pot_decorations",
      "fallback": "Pot Decorations",
      "color": "yellow"
    }
  ],
  "external_title": [
    {
      "atlas": "minecraft:items",
      "sprite": "minecraft:item/danger_pottery_sherd"
    },
    " ",
    {
      "translate": "component.i-editor.pot_decorations",
      "fallback": "Pot Decorations"
    }
  ],
  "body": {
    "type": "minecraft:item",
    "item": {
      "id": "minecraft:danger_pottery_sherd"
    },
    "description": {
      "translate": "description.i-editor.component.pot_decorations",
      "fallback": "Enter the sherd ID for each side of the decorated pot that will be displayed there:",
      "color": "gray"
    },
    "show_decorations": false,
    "show_tooltip": false
  },
  "inputs": [
    {
      "type": "minecraft:text",
      "key": "back",
      "label": {
        "translate": "subtitle.i-editor.back",
        "fallback": "Back"
      }
    },
    {
      "type": "minecraft:text",
      "key": "left",
      "label": {
        "translate": "subtitle.i-editor.left",
        "fallback": "Left"
      }
    },
    {
      "type": "minecraft:text",
      "key": "right",
      "label": {
        "translate": "subtitle.i-editor.right",
        "fallback": "Right"
      }
    },
    {
      "type": "minecraft:text",
      "key": "front",
      "label": {
        "translate": "subtitle.i-editor.front",
        "fallback": "Front"
      }
    }
  ],
  "can_close_with_escape": true,
  "pause": false,
  "after_action": "none",
  "yes": {
    "label": {
      "translate": "gui.done",
      "color": "green"
    },
    "action": {
      "type": "dynamic/run_command",
      "template": "execute if items entity @s weapon.mainhand * run item modify entity @s weapon.mainhand {\"type\":\"minecraft:set_components\",\"components\":{\"minecraft:pot_decorations\":{\"back\":\"$(back)\",\"left\":\"$(left)\",\"right\":\"$(right)\",\"front\":\"$(front)\"}}}"
    }
  },
  "no": {
    "label": {
      "translate": "gui.back",
      "color": "red"
    },
    "action": {
      "type": "show_dialog",
      "dialog": "i-editor:set_component"
    }
  }
}