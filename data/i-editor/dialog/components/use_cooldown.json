{
  "type": "minecraft:confirmation",
  "title": [
    {
      "translate": "title.i-editor.component",
      "fallback": "Component"
    },
    ": ",
    {
      "translate": "component.i-editor.use_cooldown",
      "fallback": "Use Cooldown",
      "color": "yellow"
    }
  ],
  "external_title": [
    {
      "atlas": "minecraft:items",
      "sprite": "minecraft:item/ender_pearl"
    },
    " ",
    {
      "translate": "component.i-editor.use_cooldown",
      "fallback": "Use Cooldown"
    }
  ],
  "body": {
    "type": "minecraft:item",
    "item": {
      "id": "minecraft:ender_pearl"
    },
    "description": {
      "translate": "description.i-editor.component.use_cooldown",
      "fallback": "Enter the cooldown time of the item being used and, if necessary, the cooldown group:",
      "color": "gray"
    },
    "show_decorations": false,
    "show_tooltip": false
  },
  "inputs": [
    {
      "type": "minecraft:text",
      "key": "seconds",
      "width": 150,
      "label": [
        {
          "atlas": "minecraft:items",
          "sprite": "minecraft:item/clock_00"
        },
        " ",
        {
          "translate": "subtitle.i-editor.seconds",
          "fallback": "Seconds"
        },
        " ",
        {
          "text": "<",
          "color": "dark_gray"
        },
        {
          "translate": "subtitle.i-editor.min",
          "fallback": "min:",
          "color": "dark_gray"
        },
        " ",
        {
          "text": "1",
          "color": "dark_gray"
        },
        {
          "text": ">",
          "color": "dark_gray"
        }
      ],
      "initial": "1",
      "max_length": 9999
    },
    {
      "type": "minecraft:text",
      "key": "cooldown_group",
      "width": 150,
      "label": {
        "translate": "subtitle.i-editor.cooldown_group",
        "fallback": "Cooldown Group"
      },
      "max_length": 9999
    }
  ],
  "can_close_with_escape": true,
  "pause": false,
  "after_action": "none",
  "yes": {
    "label": {
      "translate": "gui.done",
      "color": "green"
    },
    "action": {
      "type": "dynamic/run_command",
      "template": "execute if items entity @s weapon.mainhand * run item modify entity @s weapon.mainhand {\"type\":\"minecraft:set_components\",\"components\":{\"minecraft:use_cooldown\":{\"seconds\":$(seconds),\"cooldown_group\": \"$(cooldown_group)\"}}}"
    }
  },
  "no": {
    "label": {
      "translate": "gui.back",
      "color": "red"
    },
    "action": {
      "type": "show_dialog",
      "dialog": "i-editor:set_component"
    }
  }
}