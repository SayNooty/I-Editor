{
  "type": "minecraft:confirmation",
  "title": [
    {
      "translate": "title.i-editor.component",
      "fallback": "Component"
    },
    ": ",
    {
      "translate": "component.i-editor.provides_banner_patterns",
      "fallback": "Provides Banner Patterns",
      "color": "yellow"
    }
  ],
