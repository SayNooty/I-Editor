          }
        },
        {
          "id": "flow",
          "display": {
            "translate": "banner_pattern.i-editor.flow",
            "fallback": "Flow"
          }
        },
        {
          "id": "flower",
          "display": {
            "translate": "banner_pattern.i-editor.flower",
            "fallback": "Flower"
          }
        },
        {
          "id": "globe",
          "display": {
            "translate": "banner_pattern.i-editor.globe",
            "fallback": "Globe"
          }
        },
        {
          "id": "guster",
          "display": {
            "translate": "banner_pattern.i-editor.guster",
            "fallback": "Guster"
          }
        },
        {
          "id": "mojang",
          "display": {
            "translate": "banner_pattern.i-editor.mojang",
            "fallback": "Mojang"
          }
        },
        {
          "id": "piglin",
          "display": {
            "translate": "banner_pattern.i-editor.piglin",
            "fallback": "Piglin"
          }
        },
        {
          "id": "skull",
          "display": {
            "translate": "banner_pattern.i-editor.skull",
            "fallback": "Skull"
          }
        }
      ]
    }
