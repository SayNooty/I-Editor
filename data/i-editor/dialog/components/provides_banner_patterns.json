    "fallback": "Provides Banner Patterns"
  },
  "body": {
    "type": "minecraft:item",
    "item": {
      "id": "minecraft:creeper_banner_pattern"
    },
    "description": {
      "translate": "description.i-editor.component.provides_banner_patterns",
      "fallback": "Select the pattern that will be applied when using the item in the loom:",
      "color": "gray"
    },
    "show_decorations": false,
    "show_tooltip": false
  },
  "inputs": [
    {
      "type": "minecraft:single_option",
      "key": "pattern",
      "label": {
