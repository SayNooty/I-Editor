      "options": [
        {
          "id": "no_item_required",
          "display": {
            "translate": "subtitle.i-editor.no_item_required",
            "fallback": "No Item Required"
          }
        },
        {
          "id": "bordure_indented",
          "display": {
            "translate": "banner_pattern.i-editor.bordure_indeted",
            "fallback": "Bordure Indented"
          }
        },
        {
          "id": "creeper",
          "display": {
            "translate": "banner_pattern.i-editor.creeper",
            "fallback": "Creeper"
          }
        },
        {
          "id": "field_masoned",
          "display": {
            "translate": "banner_pattern.i-editor.fleid_masoned",
