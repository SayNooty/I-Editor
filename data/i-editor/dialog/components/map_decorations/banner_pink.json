{
  "type": "minecraft:confirmation",
  "title": [
    {
      "translate": "title.i-editor.component",
      "fallback": "Component"
    },
	": ",
    {
      "translate": "component.i-editor.map_decorations",
      "fallback": "Map Decorations",
      "color": "yellow"
    },
    " ",
    {
      "text": "|",
      "color": "gray"
    },
	" ",
    {
      "translate": "block.minecraft.pink_banner",
      "color": "gold"
    }
  ],
  "external_title": {
    "translate": "block.minecraft.pink_banner"
  },
  "body": {
    "type": "minecraft:item",
    "item": {
      "id": "minecraft:pink_banner"
    },
    "description": {
      "translate": "description.i-editor.component.map_decorations.marker",
      "fallback": "Enter the name and the x, z coordinates and the rotation of the marker:",
      "color": "gray"
    },
    "show_decorations": false,
    "show_tooltip": false
  },
  "inputs": [
    {
      "type": "minecraft:text",
      "key": "name",
      "width": 150,
      "label": {
        "translate": "subtitle.i-editor.name",
        "fallback": "Name"
      },
      "max_length": 9999
    },
    {
      "type": "minecraft:text",
      "key": "pos_x",
      "width": 150,
      "label": [
        {
          "translate": "subtitle.i-editor.pos",
          "fallback": "Pos"
        },
        " ",
        {
          "text": "<x>",
          "color": "dark_gray"
        }
      ],
      "initial": "0",
      "max_length": 9999
    },
    {
      "type": "minecraft:text",
      "key": "pos_z",
      "width": 150,
      "label": [
        {
          "translate": "subtitle.i-editor.pos",
          "fallback": "Pos"
        },
        " ",
        {
          "text": "<z>",
          "color": "dark_gray"
        }
      ],
      "initial": "0",
      "max_length": 9999
    },
    {
      "type": "minecraft:text",
      "key": "rotation",
      "width": 150,
      "label": {
        "translate": "subtitle.i-editor.rotation",
        "fallback": "Rotation"
      },
      "initial": "0",
      "max_length": 9999
    }
  ],
  "can_close_with_escape": true,
  "pause": false,
  "after_action": "none",
  "yes": {
    "label": {
      "translate": "gui.done",
      "color": "green"
    },
    "action": {
      "type": "dynamic/run_command",
      "template": "execute if items entity @s weapon.mainhand * run item modify entity @s weapon.mainhand {\"type\":\"minecraft:set_components\",\"components\":{\"minecraft:map_decorations\":{\"$(name)\":{\"type\":\"minecraft:banner_pink\",\"x\":$(pos_x),\"z\":$(pos_z),\"rotation\":$(rotation)}}}}"
    }
  },
  "no": {
    "label": {
      "translate": "gui.back",
      "color": "red"
    },
    "action": {
      "type": "show_dialog",
      "dialog": "i-editor:components/map_decorations"
    }
  }
}