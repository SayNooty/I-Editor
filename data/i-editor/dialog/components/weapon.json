{
  "type": "minecraft:confirmation",
  "title": [
    {
      "translate": "title.i-editor.component",
      "fallback": "Component"
    },
    ": ",
    {
      "translate": "component.i-editor.weapon",
      "fallback": "Weapon",
      "color": "yellow"
    }
  ],
  "external_title": {
    "translate": "component.i-editor.weapon",
    "fallback": "Weapon"
  },
  "body": {
    "type": "minecraft:item",
    "item": {
      "id": "minecraft:diamond_sword"
    },
    "description": {
      "translate": "description.i-editor.component.weapon",
      "fallback": "Enter the cost of strength per hit and the count of seconds for which this item can disable the blocking shield upon a successful attack:",
      "color": "gray"
    },
    "show_decorations": false,
    "show_tooltip": false
  },
  "inputs": [
    {
      "type": "minecraft:text",
      "key": "item_damage_per_attack",
      "label": [
        {
          "translate": "subtitle.i-editor.item_damage_per_attack",
          "fallback": "Item Damage Per Attack"
        },
        " ",
        {
        "text": "<",
        "color": "dark_gray"
        },
        {
          "translate": "subtitle.i-editor.min",
          "fallback": "min:",
          "color": "dark_gray"
        },
        " ",
        {
          "text": "0",
          "color": "dark_gray"
        },
        {
          "text": ">",
          "color": "dark_gray"
        }
      ],
      "max_length": 9999
    },
    {
      "type": "minecraft:text",
      "key": "disable_blocking_for_seconds",
      "label": [
        {
          "translate": "subtitle.i-editor.disable_blocking_for_seconds",
          "fallback": "Disable Blocking For Seconds"
        },
        " ",
        {
        "text": "<",
        "color": "dark_gray"
        },
        {
          "translate": "subtitle.i-editor.min",
          "fallback": "min:",
          "color": "dark_gray"
        },
        " ",
        {
          "text": "0",
          "color": "dark_gray"
        },
        {
          "text": ">",
          "color": "dark_gray"
        }
      ]
    }
  ],
  "can_close_with_escape": true,
  "pause": false,
  "after_action": "none",
  "yes": {
    "label": {
      "translate": "gui.done",
      "color": "green"
    },
    "action": {
      "type": "dynamic/run_command",
      "template": "execute if items entity @s weapon.mainhand * run item modify entity @s weapon.mainhand [{\"function\":\"minecraft:set_components\",\"components\":{\"minecraft:weapon\":{\"item_damage_per_attack\":$(item_damage_per_attack),\"disable_blocking_for_seconds\":$(disable_blocking_for_seconds)}}}]"
    }
  },
  "no": {
    "label": {
      "translate": "gui.back",
      "color": "red"
    },
    "action": {
      "type": "show_dialog",
      "dialog": "i-editor:set_component"
    }
  }
}