{
  "type": "minecraft:confirmation",
  "title": [
    {
      "translate": "title.i-editor.component",
      "fallback": "Component"
    },
    ": ",
    {
      "translate": "component.i-editor.max_damage",
      "fallback": "Max Damage",
      "color": "yellow"
    }
  ],
  "external_title": [
    {
      "atlas": "minecraft:items",
      "sprite": "minecraft:item/diamond_axe"
    },
    " ",
    {
    "translate": "component.i-editor.max_damage",
    "fallback": "Max Damage"
    }
  ],
  "body": {
    "type": "minecraft:item",
    "item": {
      "id": "minecraft:diamond_axe"
    },
    "description": {
      "translate": "description.i-editor.component.max_damage",
      "fallback": "Enter the maximum usage count of the item to break:",
      "color": "gray"
    },
    "show_decorations": false,
    "show_tooltip": false
  },
  "inputs": [
    {
      "type": "minecraft:text",
      "key": "count",
      "width": 125,
      "label": {
        "translate": "subtitle.i-editor.count",
        "fallback": "Count"
      },
      "max_length": 9999
    }
  ],
  "can_close_with_escape": true,
  "pause": false,
  "after_action": "none",
  "yes": {
    "label": {
      "translate": "gui.done",
      "color": "green"
    },
    "action": {
      "type": "dynamic/run_command",
      "template": "execute if items entity @s weapon.mainhand * run item modify entity @s weapon.mainhand {\"type\":\"minecraft:set_components\",\"components\":{\"minecraft:max_damage\":$(count)}}"
    }
  },
  "no": {
    "label": {
      "translate": "gui.back",
      "color": "red"
    },
    "action": {
      "type": "show_dialog",
      "dialog": "i-editor:set_component"
    }
  }
}