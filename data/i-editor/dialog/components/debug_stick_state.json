{
  "type": "minecraft:confirmation",
  "title": [
    {
      "translate": "title.i-editor.component",
      "fallback": "Component"
    },
    ": ",
    {
      "translate": "component.i-editor.debug_stick_state",
      "fallback": "Debug Stick State",
      "color": "yellow"
    }
  ],
  "external_title": [
    {
      "atlas": "minecraft:items",
      "sprite": "minecraft:item/stick"
    },
    " ",
    {
    "translate": "component.i-editor.debug_stick_state",
    "fallback": "Debug Stick State"
    }
  ],
  "body": {
    "type": "minecraft:item",
    "item": {
      "id": "minecraft:debug_stick"
    },
    "description": {
      "translate": "description.i-editor.component.debug_stick_state",
      "fallback": "Enter the block ID and its state, which will be applied to the debug stick:",
      "color": "gray"
    },
    "show_decorations": false,
    "show_tooltip": false
  },
  "inputs": [
    {
      "type": "minecraft:text",
      "key": "block_id",
      "label": {
        "translate": "subtitle.i-editor.block_id",
        "fallback": "Block ID"
      },
      "max_length": 9999
    },
    {
      "type": "minecraft:text",
      "key": "state",
      "label": {
        "translate": "subtitle.i-editor.state",
        "fallback": "State"
      },
      "max_length": 9999
    }
  ],
  "can_close_with_escape": true,
  "pause": false,
  "after_action": "none",
  "yes": {
    "label": {
      "translate": "gui.done",
      "color": "green"
    },
    "action": {
      "type": "dynamic/run_command",
      "template": "execute if items entity @s weapon.mainhand * run item modify entity @s weapon.mainhand {\"type\":\"minecraft:set_components\",\"components\":{\"minecraft:debug_stick_state\":{\"$(block_id)\":\"$(state)\"}}}"
    }
  },
  "no": {
    "label": {
      "translate": "gui.back",
      "color": "red"
    },
    "action": {
      "type": "show_dialog",
      "dialog": "i-editor:set_component"
    }
  }
}