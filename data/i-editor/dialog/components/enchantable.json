{
  "type": "minecraft:confirmation",
  "title": [
    {
      "translate": "title.i-editor.component",
      "fallback": "Component"
    },
    ": ",
    {
      "translate": "component.i-editor.enchantable",
      "fallback": "Enchantable",
      "color": "yellow"
    }
  ],
  "external_title": {
    "translate": "component.i-editor.enchantable",
    "fallback": "Enchantable"
  },
  "body": {
    "type": "minecraft:item",
    "item": {
      "id": "minecraft:enchanted_book"
    },
    "description": {
      "translate": "description.i-editor.component.enchantable",
      "fallback": "Enter the enchantment cost level in the enchantment table:",
      "color": "gray"
    },
    "show_decorations": false,
    "show_tooltip": false
  },
  "inputs": [
    {
      "type": "minecraft:text",
      "key": "value",
      "width": 125,
      "label": [
        {
          "translate": "subtitle.i-editor.value",
          "fallback": "Value"
        },
        " ",
        {
        "text": "<",
        "color": "dark_gray"
        },
        {
          "translate": "subtitle.i-editor.min",
          "fallback": "min:",
          "color": "dark_gray"
        },
        " ",
        {
          "text": "1",
          "color": "dark_gray"
        },
        {
          "text": ">",
          "color": "dark_gray"
        }
      ],
      "max_length": 9999
    }
  ],
  "can_close_with_escape": true,
  "pause": false,
  "after_action": "none",
  "yes": {
    "label": {
      "translate": "gui.done",
      "color": "green"
    },
    "action": {
      "type": "dynamic/run_command",
      "template": "execute if items entity @s weapon.mainhand * run item modify entity @s weapon.mainhand [{\"function\":\"minecraft:set_components\",\"components\":{\"minecraft:enchantable\":{\"value\":$(value)}}}]"
    }
  },
  "no": {
    "label": {
      "translate": "gui.back",
      "color": "red"
    },
    "action": {
      "type": "show_dialog",
      "dialog": "i-editor:set_component"
    }
  }
}