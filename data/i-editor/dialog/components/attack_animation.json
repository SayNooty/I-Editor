{
  "type": "minecraft:confirmation",
  "title": [
    {
      "translate": "title.i-editor.component",
      "fallback": "Component"
    },
    ": ",
    {
      "translate": "component.i-editor.attack_animation",
      "fallback": "Attack Animation",
      "color": "yellow"
    }
  ],
  "external_title": [
    {
      "atlas": "minecraft:items",
      "sprite": "minecraft:item/netherite_spear"
    },
    " ",
    {
    "translate": "component.i-editor.attack_animation",
    "fallback": "Attack Animation"
    }
  ],
  "body": {
    "type": "minecraft:item",
    "item": {
      "id": "minecraft:netherite_spear"
    },
    "description": {
      "translate": "description.i-editor.component.attack_animation",
      "fallback": "Select the type of impact animation and its duration:",
      "color": "gray"
    },
    "show_decorations": false,
    "show_tooltip": false
  },
  "inputs": [
    {
      "type": "minecraft:single_option",
      "key": "type",
      "label": {
        "translate": "subtitle.i-editor.type",
        "fallback": "Type"
      },
      "options": [
        {
          "id": "whack",
          "display": {
            "translate": "subtitle.i-editor.whack",
            "fallback": "Whack"
          }
        },
        {
          "id": "stab",
          "display": {
            "translate": "subtitle.i-editor.stab",
            "fallback": "Stab"
          }
        }
      ]
    },
    {
      "type": "minecraft:text",
      "key": "duration",
      "label": [
        {
          "translate": "subtitle.i-editor.duration",
          "fallback": "Duration"
        },
        " ",
        {
          "translate": "subtitle.i-editor.in_ticks",
          "fallback": "[in ticks]",
          "color": "gray"
        },
        " ",
        {
        "text": "<",
        "color": "dark_gray"
        },
        {
          "translate": "subtitle.i-editor.min",
          "fallback": "min:",
          "color": "dark_gray"
        },
        " ",
        {
          "text": "1",
          "color": "dark_gray"
        },
        {
          "text": ">",
          "color": "dark_gray"
        }
      ],
      "max_length": 9
    }
  ],
  "can_close_with_escape": true,
  "pause": false,
  "after_action": "none",
  "yes": {
    "label": {
      "translate": "gui.done",
      "color": "green"
    },
    "action": {
      "type": "dynamic/run_command",
      "template": "execute if items entity @s weapon.mainhand * run item modify entity @s weapon.mainhand {\"type\":\"minecraft:set_components\",\"components\":{\"minecraft:attack_animation\":{\"type\":\"$(type)\",\"duration\":$(duration)}}}"
    }
  },
  "no": {
    "label": {
      "translate": "gui.back",
      "color": "red"
    },
    "action": {
      "type": "show_dialog",
      "dialog": "i-editor:set_component"
    }
  }
}