{
  "type": "minecraft:confirmation",
  "title": [
    {
      "translate": "title.i-editor.component",
      "fallback": "Component"
    },
    ": ",
    {
      "translate": "component.i-editor.suspicious_stew_effects",
      "fallback": "Suspicious Stew Effects",
      "color": "yellow"
    }
  ],
  "external_title": {
    "translate": "component.i-editor.suspicious_stew_effects",
    "fallback": "Suspicious Stew Effects"
  },
  "body": {
    "type": "minecraft:item",
    "item": {
      "id": "minecraft:suspicious_stew"
    },
    "description": {
      "translate": "description.i-editor.component.suspicious_stew_effects",
      "fallback": "Enter the effect ID and the duration of the effect applied to the player or mob when using this item (similar to a suspicious stew):",
      "color": "gray"
    },
    "show_decorations": false,
    "show_tooltip": false
  },
  "inputs": [
    {
      "type": "minecraft:text",
      "key": "effect_id",
      "label": {
        "translate": "subtitle.i-editor.effect_id",
        "fallback": "Effect ID"
      },
      "max_length": 9999
    },
    {
      "type": "minecraft:text",
      "key": "duration",
      "label": [
        {
          "translate": "subtitle.i-editor.duration",
          "fallback": "Duration"
        },
        " ",
        {
          "translate": "subtitle.i-editor.tick",
          "fallback": "[in ticks]",
          "color": "gray"
        }
      ],
      "initial": "160",
      "max_length": 9999
    }
  ],
  "can_close_with_escape": true,
  "pause": false,
  "after_action": "none",
  "yes": {
    "label": {
      "translate": "gui.done",
      "color": "green"
    },
    "action": {
      "type": "dynamic/run_command",
      "template": "execute if items entity @s weapon.mainhand * run item modify entity @s weapon.mainhand [{\"function\":\"minecraft:set_components\",\"components\":{\"minecraft:suspicious_stew_effects\":[{\"id\":\"$(effect_id)\",\"duration\":$(duration)}]}}]"
    }
  },
  "no": {
    "label": {
      "translate": "gui.back",
      "color": "red"
    },
    "action": {
      "type": "show_dialog",
      "dialog": "i-editor:set_component"
    }
  }
}