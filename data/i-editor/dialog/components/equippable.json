    "label": {
      "translate": "gui.done",
      "color": "green"
    },
    "action": {
      "type": "dynamic/run_command",
      "template": "execute if items entity @s weapon.mainhand * run item modify entity @s weapon.mainhand {\"type\":\"minecraft:set_components\",\"components\":{\"minecraft:equippable\":{\"slot\":\"$(slot)\",\"equip_sound\":\"$(equip_sound)\",\"asset_id\":\"$(displayed_model)\",\"camera_entities\":\"$(camera_entities)\",\"dispensable\":$(interaction_in_dispenser),\"swappable\":$(swappable),\"damage_on_hurt\":$(damage_on_hurt),\"equip_on_interact\":$(equip_on_interact),\"can_be_sheared\":$(can_be_sheared),\"shearing_sound\":\"$(shearing_sound)\"}}}"
    }
  },
  "no": {
    "label": {
      "translate": "gui.back",
      "color": "red"
    },
    "action": {
      "type": "show_dialog",
      "dialog": "i-editor:set_component"
    }
  }
