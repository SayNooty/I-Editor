        },
        " ",
        {
          "translate": "subtitle.i-editor.interaction_in_dispenser",
          "fallback": "Interaction In Dispenser"
        }
      ],
      "initial": true
    },
    {
      "type": "minecraft:boolean",
      "key": "swappable",
      "label": {
        "translate": "subtitle.i-editor.swappable",
