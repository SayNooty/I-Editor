    {
      "type": "minecraft:boolean",
      "key": "equip_on_interact",
      "label": {
        "translate": "subtitle.i-editor.equip_on_interact",
        "fallback": "Equip On Interact"
      },
      "initial": false
    },
    {
      "type": "minecraft:boolean",
      "key": "can_be_sheared",
      "label": [
        {
          "atlas": "minecraft:items",
          "sprite": "minecraft:item/shears"
        },
