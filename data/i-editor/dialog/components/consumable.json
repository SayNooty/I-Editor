{
  "type": "minecraft:confirmation",
  "title": [
    {
      "translate": "title.i-editor.component",
      "fallback": "Component"
    },
    ": ",
    {
      "translate": "component.i-editor.consumable",
      "fallback": "Consumable",
      "color": "yellow"
    }
  ],
  "external_title": [
    {
      "atlas": "minecraft:items",
      "sprite": "minecraft:item/golden_apple"
    },
    " ",
    {
      "translate": "component.i-editor.consumable",
      "fallback": "Consumable"
    }
  ],
  "body": {
    "type": "minecraft:item",
    "item": {
      "id": "minecraft:golden_apple"
    },
    "description": {
      "translate": "description.i-editor.component.consumable",
      "fallback": "Enter the values and configure the consumption configuration like a food:",
      "color": "gray"
    },
    "show_decorations": false,
    "show_tooltip": false
  },
  "inputs": [
    {
      "type": "minecraft:text",
      "key": "consumption_time",
      "label": [
        {
          "atlas": "minecraft:items",
          "sprite": "minecraft:item/clock_00"
        },
        " ",
        {
          "translate": "subtitle.i-editor.consumption_time",
          "fallback": "Consumption Time"
        },
        " ",
        {
          "translate": "subtitle.i-editor.in_seconds",
          "fallback": "[in seconds]",
          "color": "gray"
        }
      ],
      "initial": "1.6",
      "max_length": 9999
    },
    {
      "type": "minecraft:single_option",
      "key": "animation",
      "label": {
        "translate": "subtitle.i-editor.animation",
        "fallback": "Animation"
      },
      "options": [
        {
          "id": "none",
          "display": {
            "translate": "gui.no"
          }
        },
        {
          "id": "eat",
          "display": [
            {
              "atlas": "minecraft:items",
              "sprite": "minecraft:item/cooked_beef"
            },
            " ",
            {
              "translate": "subtitle.i-editor.eat",
              "fallback": "Eat"
            }
          ]
        },
        {
          "id": "drink",
          "display": [
            {
              "atlas": "minecraft:items",
              "sprite": "minecraft:item/potion"
            },
            " ",
            {
              "translate": "subtitle.i-editor.drink",
              "fallback": "Drink"
            }
          ]
        },
        {
          "id": "block",
          "display": {
            "translate": "subtitle.i-editor.block",
            "fallback": "Block"
          }
        },
        {
          "id": "bow",
          "display": [
            {
              "atlas": "minecraft:items",
              "sprite": "minecraft:item/bow"
            },
            " ",
            {
              "translate": "item.minecraft.bow"
            }
          ]
        },
        {
          "id": "trident",
          "display": [
            {
              "atlas": "minecraft:items",
              "sprite": "minecraft:item/trident"
            },
            " ",
            {
              "translate": "item.minecraft.trident"
            }
          ]
        },
        {
          "id": "spear",
          "display": [
            {
              "atlas": "minecraft:items",
              "sprite": "minecraft:item/iron_spear"
            },
            " ",
            {
              "translate": "subtitle.i-editor.spear",
              "fallback": "Spear"
            }
          ]
        },
        {
          "id": "crossbow",
          "display": [
            {
              "atlas": "minecraft:items",
              "sprite": "minecraft:item/crossbow_pulling_0"
            },
            " ",
            {
              "translate": "item.minecraft.crossbow"
            }
          ]
        },
        {
          "id": "spyglass",
          "display": [
            {
              "atlas": "minecraft:items",
              "sprite": "minecraft:item/spyglass"
            },
            " ",
            {
              "translate": "item.minecraft.spyglass"
            }
          ]
        },
        {
          "id": "toot_horn",
          "display": [
            {
              "atlas": "minecraft:items",
              "sprite": "minecraft:item/goat_horn"
            },
            " ",
            {
              "translate": "item.minecraft.goat_horn"
            }
          ]
        },
        {
          "id": "brush",
          "display": [
            {
              "atlas": "minecraft:items",
              "sprite": "minecraft:item/brush"
            },
            " ",
            {
              "translate": "item.minecraft.brush"
            }
          ]
        },
        {
          "id": "bundle",
          "display": [
            {
              "atlas": "minecraft:items",
              "sprite": "minecraft:item/bundle"
            },
            " ",
            {
              "translate": "item.minecraft.bundle"
            }
          ]
        }
      ]
    },
    {
      "type": "minecraft:text",
      "key": "sound_id",
      "label": {
        "translate": "subtitle.i-editor.sound_id",
        "fallback": "Sound ID"
      },
      "initial": "minecraft:entity.generic.eat",
      "max_length": 9999
    },
    {
      "type": "minecraft:boolean",
      "key": "has_consume_particles",
      "label": {
        "translate": "subtitle.i-editor.has_consume_particles",
        "fallback": "Has Consume Particles"
      },
      "initial": true
    }
  ],
  "can_close_with_escape": true,
  "pause": false,
  "after_action": "none",
  "yes": {
    "label": {
      "translate": "gui.done",
      "color": "green"
    },
    "action": {
      "type": "dynamic/run_command",
      "template": "execute if items entity @s weapon.mainhand * run item modify entity @s weapon.mainhand {\"type\":\"minecraft:set_components\",\"components\":{\"minecraft:consumable\":{\"consume_seconds\":$(consumption_time),\"animation\":\"$(animation)\",\"sound\":\"$(sound_id)\",\"has_consume_particles\":$(has_consume_particles)}}}"
    }
  },
  "no": {
    "label": {
      "translate": "gui.back",
      "color": "red"
    },
    "action": {
      "type": "show_dialog",
      "dialog": "i-editor:set_component"
    }
  }
}