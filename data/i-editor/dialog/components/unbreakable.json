{
  "type": "minecraft:confirmation",
  "title": [
    {
      "translate": "title.i-editor.component",
      "fallback": "Component"
    },
    ": ",
    {
      "translate": "component.i-editor.unbreakable",
      "fallback": "Unbreakable",
      "color": "yellow"
    }
  ],
  "external_title": [
    {
      "atlas": "minecraft:blocks",
      "sprite": "minecraft:block/bedrock"
    },
    " ",
    {
    "translate": "component.i-editor.unbreakable",
    "fallback": "Unbreakable"
    }
  ],
  "body": {
    "type": "minecraft:item",
    "item": {
      "id": "minecraft:bedrock"
    },
    "description": {
      "translate": "description.i-editor.component.unbreakable",
      "fallback": "You don't need to configure anything here, just click \"Done\" to make the item invulnerable to damage, and if you don't want to do this, then click \"Back\":",
      "color": "gray"
    },
    "show_decorations": false,
    "show_tooltip": false
  },
  "inputs": [],
  "can_close_with_escape": true,
  "pause": false,
  "after_action": "none",
  "yes": {
    "label": {
      "translate": "gui.done",
      "color": "green"
    },
    "action": {
      "type": "dynamic/run_command",
      "template": "execute if items entity @s weapon.mainhand * run item modify entity @s weapon.mainhand {\"type\":\"minecraft:set_components\",\"components\":{\"minecraft:unbreakable\":{$(unbreakable)}}}"
    }
  },
  "no": {
    "label": {
      "translate": "gui.back",
      "color": "red"
    },
    "action": {
      "type": "show_dialog",
      "dialog": "i-editor:set_component"
    }
  }
}