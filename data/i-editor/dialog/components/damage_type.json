{
  "type": "minecraft:confirmation",
  "title": [
    {
      "translate": "title.i-editor.component",
      "fallback": "Component"
    },
    ": ",
    {
      "translate": "component.i-editor.damage_type",
      "fallback": "Damage Type",
      "color": "yellow"
    }
  ],
  "external_title": [
    {
      "atlas": "minecraft:items",
      "sprite": "minecraft:item/stone_sword"
    },
    " ",
    {
    "translate": "component.i-editor.damage_type",
    "fallback": "Damage Type"
    }
  ],
  "body": {
    "type": "minecraft:item",
    "item": {
      "id": "minecraft:stone_sword"
    },
    "description": {
      "translate": "description.i-editor.component.damage_type",
      "fallback": "Adjust the damage type for the item:",
      "color": "gray"
    },
    "show_decorations": false,
    "show_tooltip": false
  },
  "inputs": [
    {
      "type": "minecraft:text",
      "key": "damage_id",
      "width": 150,
      "label": {
        "translate": "subtitle.i-editor.damage_id",
        "fallback": "Damage ID"
      },
      "max_length": 9999
    }
  ],
  "can_close_with_escape": true,
  "pause": false,
  "after_action": "none",
  "yes": {
    "label": {
      "translate": "gui.done",
      "color": "green"
    },
    "action": {
      "type": "dynamic/run_command",
      "template": "execute if items entity @s weapon.mainhand * run item modify entity @s weapon.mainhand {\"type\":\"minecraft:set_components\",\"components\":{\"minecraft:damage_type\":\"$(damage_id)\"}}"
    }
  },
  "no": {
    "label": {
      "translate": "gui.back",
      "color": "red"
    },
    "action": {
      "type": "show_dialog",
      "dialog": "i-editor:set_component"
    }
  }
}