{
  "type": "minecraft:confirmation",
  "title": [
    {
      "translate": "title.i-editor.component",
      "fallback": "Component"
    },
    ": ",
    {
      "translate": "component.i-editor.damage_resistant",
      "fallback": "Damage Resistant",
      "color": "yellow"
    }
  ],
  "external_title": [
    {
      "atlas": "minecraft:items",
      "sprite": "minecraft:item/netherite_ingot"
    },
    " ",
    {
    "translate": "component.i-editor.damage_resistant",
    "fallback": "Damage Resistant"
    }
  ],
  "body": {
    "type": "minecraft:item",
    "item": {
      "id": "minecraft:netherite_ingot"
    },
    "description": {
      "translate": "description.i-editor.component.damage_resistant",
      "fallback": "Enter the specified damage type that the item will be invulnerable to:",
      "color": "gray"
    },
    "show_decorations": false,
    "show_tooltip": false
  },
  "inputs": [
    {
      "type": "minecraft:text",
      "key": "type",
      "label": {
        "translate": "subtitle.i-editor.tag",
        "fallback": "Tag"
      },
      "initial": "#minecraft:is_fire",
      "max_length": 9999
    }
  ],
  "can_close_with_escape": true,
  "pause": false,
  "after_action": "none",
  "yes": {
    "label": {
      "translate": "gui.done",
      "color": "green"
    },
    "action": {
      "type": "dynamic/run_command",
      "template": "execute if items entity @s weapon.mainhand * run item modify entity @s weapon.mainhand {\"type\":\"minecraft:set_components\",\"components\":{\"minecraft:damage_resistant\":{\"types\":\"$(type)\"}}}"
    }
  },
  "no": {
    "label": {
      "translate": "gui.back",
      "color": "red"
    },
    "action": {
      "type": "show_dialog",
      "dialog": "i-editor:set_component"
    }
  }
}