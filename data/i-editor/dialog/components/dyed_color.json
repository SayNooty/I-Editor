{
  "type": "minecraft:confirmation",
  "title": [
    {
      "translate": "title.i-editor.component",
      "fallback": "Component"
    },
    ": ",
    {
      "translate": "component.i-editor.dyed_color",
      "fallback": "Dyed Color",
      "color": "yellow"
    }
  ],
  "external_title": [
    {
      "atlas": "minecraft:items",
      "sprite": "minecraft:item/leather_chestplate"
    },
    " ",
    {
    "translate": "component.i-editor.dyed_color",
    "fallback": "Dyed Color"
    }
  ],
  "body": {
    "type": "minecraft:item",
    "item": {
      "id": "minecraft:leather_chestplate"
    },
    "description": {
      "translate": "description.i-editor.component.dyed_color",
      "fallback": "Enter the color code for coloring leather clothing and wolf armor:",
      "color": "gray"
    },
    "show_decorations": false,
    "show_tooltip": false
  },
  "inputs": [
    {
      "type": "minecraft:text",
      "key": "color_code",
      "label": [
        {
          "translate": "subtitle.i-editor.color_code",
          "fallback": "Color Code"
        },
        " ",
        {
          "translate": "subtitle.i-editor.decimal",
          "fallback": "[decimal]",
          "color": "gray"
        }
      ],
      "max_length": 9999
    }
  ],
  "can_close_with_escape": true,
  "pause": false,
  "after_action": "none",
  "yes": {
    "label": {
      "translate": "gui.done",
      "color": "green"
    },
    "action": {
      "type": "dynamic/run_command",
      "template": "execute if items entity @s weapon.mainhand * run item modify entity @s weapon.mainhand {\"type\":\"minecraft:set_components\",\"components\":{\"minecraft:dyed_color\":$(color_code)}}"
    }
  },
  "no": {
    "label": {
      "translate": "gui.back",
      "color": "red"
    },
    "action": {
      "type": "show_dialog",
      "dialog": "i-editor:set_component"
    }
  }
}