{
  "type": "minecraft:confirmation",
  "title": [
    {
      "translate": "title.i-editor.component",
      "fallback": "Component"
    },
    ": ",
    {
      "translate": "component.i-editor.use_remainder",
      "fallback": "Use Remainder",
      "color": "yellow"
    }
  ],
  "external_title": [
    {
      "atlas": "minecraft:items",
      "sprite": "minecraft:item/milk_bucket"
    },
    " ",
    {
    "translate": "component.i-editor.use_remainder",
    "fallback": "Use Remainder"
    }
  ],
  "body": {
    "type": "minecraft:item",
    "item": {
      "id": "minecraft:milk_bucket"
    },
    "description": {
      "translate": "description.i-editor.component.use_remainder",
      "fallback": "Enter the item ID and select the count of the item that will appear after consuming the previous one:",
      "color": "gray"
    },
    "show_decorations": false,
    "show_tooltip": false
  },
  "inputs": [
    {
      "type": "minecraft:text",
      "key": "item",
      "label": {
        "translate": "subtitle.i-editor.item_id",
        "fallback": "Item ID"
      },
      "max_length": 9999
    },
    {
      "type": "minecraft:number_range",
      "key": "count",
      "label": {
        "translate": "subtitle.i-editor.count",
        "fallback": "Count"
      },
      "start": 1,
      "end": 99,
      "step": 1,
      "initial": 1
    }
  ],
  "can_close_with_escape": true,
  "pause": false,
  "after_action": "none",
  "yes": {
    "label": {
      "translate": "gui.done",
      "color": "green"
    },
    "action": {
      "type": "dynamic/run_command",
      "template": "execute if items entity @s weapon.mainhand * run item modify entity @s weapon.mainhand {\"type\":\"minecraft:set_components\",\"components\":{\"minecraft:use_remainder\":{\"id\":\"$(item)\",\"count\":$(count)}}}"
    }
  },
  "no": {
    "label": {
      "translate": "gui.back",
      "color": "red"
    },
    "action": {
      "type": "show_dialog",
      "dialog": "i-editor:set_component"
    }
  }
}