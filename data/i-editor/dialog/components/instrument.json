{
  "type": "minecraft:confirmation",
  "title": [
    {
      "translate": "title.i-editor.component",
      "fallback": "Component"
    },
    ": ",
    {
      "translate": "component.i-editor.instrument",
      "fallback": "Instrument",
      "color": "yellow"
    }
  ],
  "external_title": [
    {
      "atlas": "minecraft:items",
      "sprite": "minecraft:item/goat_horn"
    },
    " ",
    {
      "translate": "component.i-editor.instrument",
      "fallback": "Instrument"
    }
  ],
  "body": {
    "type": "minecraft:item",
    "item": {
      "id": "minecraft:goat_horn"
    },
    "description": {
      "translate": "description.i-editor.component.instrument",
      "fallback": "Customize the sound instrument, its sound duration and range, as well as a description:",
      "color": "gray"
    },
    "show_decorations": false,
    "show_tooltip": false
  },
  "inputs": [
    {
      "type": "minecraft:text",
      "key": "sound_event",
      "width": 175,
      "label": {
        "translate": "subtitle.i-editor.sound_event",
        "fallback": "Sound Event"
      },
      "max_length": 9999
    },
    {
      "type": "minecraft:text",
      "key": "range",
      "width": 175,
      "label": [
        {
          "translate": "subtitle.i-editor.range",
          "fallback": "Range"
        },
        " ",
        {
          "text": "<",
          "color": "dark_gray"
        },
        {
          "translate": "subtitle.i-editor.min",
          "fallback": "min:",
          "color": "dark_gray"
        },
        " ",
        {
          "text": "1",
          "color": "dark_gray"
        },
        {
          "text": ">",
          "color": "dark_gray"
        }
      ],
      "initial": "1",
      "max_length": 9999
    },
    {
      "type": "minecraft:text",
      "key": "use_duration",
      "width": 175,
      "label": [
        {
          "atlas": "minecraft:items",
          "sprite": "minecraft:item/clock_00"
        },
        " ",
        {
          "translate": "subtitle.i-editor.use_duration",
          "fallback": "Use Duration"
        },
        " ",
        {
          "text": "<",
          "color": "dark_gray"
        },
        {
          "translate": "subtitle.i-editor.min",
          "fallback": "min:",
          "color": "dark_gray"
        },
        " ",
        {
          "text": "1",
          "color": "dark_gray"
        },
        {
          "text": ">",
          "color": "dark_gray"
        }
      ],
      "initial": "1",
      "max_length": 9999
    },
    {
      "type": "minecraft:text",
      "key": "description",
      "width": 175,
      "label": {
        "translate": "subtitle.i-editor.description",
        "fallback": "Description"
      },
      "max_length": 9999
    }
  ],
  "can_close_with_escape": true,
  "pause": false,
  "after_action": "none",
  "yes": {
    "label": {
      "translate": "gui.done",
      "color": "green"
    },
    "action": {
      "type": "dynamic/run_command",
      "template": "execute if items entity @s weapon.mainhand * run item modify entity @s weapon.mainhand {\"type\":\"minecraft:set_components\",\"components\":{\"minecraft:instrument\":{sound_event:\"$(sound_event)\",range:$(range),use_duration:$(use_duration),description:\"$(description)\"}}}"
    }
  },
  "no": {
    "label": {
      "translate": "gui.back",
      "color": "red"
    },
    "action": {
      "type": "show_dialog",
      "dialog": "i-editor:set_component"
    }
  }
}