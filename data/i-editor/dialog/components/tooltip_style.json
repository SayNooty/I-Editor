{
  "type": "minecraft:confirmation",
  "title": [
    {
      "translate": "title.i-editor.component",
      "fallback": "Component"
    },
    ": ",
    {
      "translate": "component.i-editor.tooltip_style",
      "fallback": "Tooltip Style",
      "color": "yellow"
    }
  ],
  "external_title": [
    {
      "atlas": "minecraft:items",
      "sprite": "minecraft:item/painting"
    },
    " ",
    {
    "translate": "component.i-editor.tooltip_style",
    "fallback": "Tooltip Style"
    }
  ],
  "body": {
    "type": "minecraft:item",
    "item": {
      "id": "minecraft:painting"
    },
    "description": {
      "translate": "description.i-editor.component.tooltip_style",
      "fallback": "Enter the path to the background texture file that will be displayed when the cursor hovers over the item:",
      "color": "gray"
    },
    "show_decorations": false,
    "show_tooltip": false
  },
  "inputs": [
    {
      "type": "minecraft:text",
      "key": "file_path",
      "label": {
        "translate": "subtitle.i-editor.file_path",
        "fallback": "File Path"
      },
      "max_length": 9999
    }
  ],
  "can_close_with_escape": true,
  "pause": false,
  "after_action": "none",
  "yes": {
    "label": {
      "translate": "gui.done",
      "color": "green"
    },
    "action": {
      "type": "dynamic/run_command",
      "template": "execute if items entity @s weapon.mainhand * run item modify entity @s weapon.mainhand {\"type\":\"minecraft:set_components\",\"components\":{\"minecraft:tooltip_style\":\"$(file_path)\"}}"
    }
  },
  "no": {
    "label": {
      "translate": "gui.back",
      "color": "red"
    },
    "action": {
      "type": "show_dialog",
      "dialog": "i-editor:set_component"
    }
  }
}