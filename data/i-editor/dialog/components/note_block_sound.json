{
  "type": "minecraft:confirmation",
  "title": [
    {
      "translate": "title.i-editor.component",
      "fallback": "Component"
    },
    ": ",
    {
      "translate": "component.i-editor.note_block_sound",
      "fallback": "Note Block Sound",
      "color": "yellow"
    }
  ],
  "external_title": {
    "translate": "component.i-editor.note_block_sound",
    "fallback": "Note Block Sound"
  },
  "body": {
    "type": "minecraft:item",
    "item": {
      "id": "minecraft:note_block"
    },
    "description": {
      "translate": "description.i-editor.component.note_block_sound",
      "fallback": "Enter the sound ID for the head that will play the sound when it stands on the note block:",
      "color": "gray"
    },
    "show_decorations": false,
    "show_tooltip": false
  },
  "inputs": [
    {
      "type": "minecraft:text",
      "key": "sound",
      "label": {
        "translate": "subtitle.i-editor.sound",
        "fallback": "Sound"
      },
      "max_length": 9999
    }
  ],
  "can_close_with_escape": true,
  "pause": false,
  "after_action": "none",
  "yes": {
    "label": {
      "translate": "gui.done",
      "color": "green"
    },
    "action": {
      "type": "dynamic/run_command",
      "template": "execute if items entity @s weapon.mainhand * run item modify entity @s weapon.mainhand [{\"function\":\"minecraft:set_components\",\"components\":{\"minecraft:note_block_sound\":\"$(sound)\"}}]"
    }
  },
  "no": {
    "label": {
      "translate": "gui.back",
      "color": "red"
    },
    "action": {
      "type": "show_dialog",
      "dialog": "i-editor:set_component"
    }
  }
}