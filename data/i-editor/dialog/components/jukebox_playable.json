{
  "type": "minecraft:confirmation",
  "title": [
    {
      "translate": "title.i-editor.component",
      "fallback": "Component"
    },
    ": ",
    {
      "translate": "component.i-editor.jukebox_playable",
      "fallback": "Jukebox Playable",
      "color": "yellow"
    }
  ],
  "external_title": [
    {
      "atlas": "minecraft:items",
      "sprite": "minecraft:item/music_disc_cat"
    },
    " ",
    {
    "translate": "component.i-editor.jukebox_playable",
    "fallback": "Jukebox Playable"
    }
  ],
  "body": {
    "type": "minecraft:item",
    "item": {
      "id": "minecraft:music_disc_cat"
    },
    "description": {
      "translate": "description.i-editor.component.jukebox_playable",
      "fallback": "Enter the music ID so that the item plays music in the jokebox:",
      "color": "gray"
    },
    "show_decorations": false,
    "show_tooltip": false
  },
  "inputs": [
    {
      "type": "minecraft:text",
      "key": "music_id",
      "label": {
        "translate": "subtitle.i-editor.music_id",
        "fallback": "Music ID"
      },
      "initial": "minecraft:pigstep",
      "max_length": 9999
    }
  ],
  "can_close_with_escape": true,
  "pause": false,
  "after_action": "none",
  "yes": {
    "label": {
      "translate": "gui.done",
      "color": "green"
    },
    "action": {
      "type": "dynamic/run_command",
      "template": "execute if items entity @s weapon.mainhand * run item modify entity @s weapon.mainhand {\"type\":\"minecraft:set_components\",\"components\":{\"minecraft:jukebox_playable\":\"$(music_id)\"}}"
    }
  },
  "no": {
    "label": {
      "translate": "gui.back",
      "color": "red"
    },
    "action": {
      "type": "show_dialog",
      "dialog": "i-editor:set_component"
    }
  }
}