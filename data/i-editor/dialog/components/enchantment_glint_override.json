{
  "type": "minecraft:confirmation",
  "title": [
    {
      "translate": "title.i-editor.component",
      "fallback": "Component"
    },
    ": ",
    {
      "translate": "component.i-editor.enchantment_glint_override",
      "fallback": "Enchantment Glint Override",
      "color": "yellow"
    }
  ],
  "external_title": [
    {
      "atlas": "minecraft:items",
      "sprite": "minecraft:item/experience_bottle"
    },
    " ",
    {
    "translate": "component.i-editor.enchantment_glint_override",
    "fallback": "Enchantment Glint Override"
    }
  ],
  "body": {
    "type": "minecraft:item",
    "item": {
      "id": "minecraft:experience_bottle"
    },
    "description": {
      "translate": "description.i-editor.component.enchantment_glint_override",
      "fallback": "Click on the checkmark so that the item can glint like enchanted books:",
      "color": "gray"
    },
    "show_decorations": false,
    "show_tooltip": false
  },
  "inputs": [
    {
      "type": "minecraft:boolean",
      "key": "has_glint",
      "label": [
        {
          "translate": "subtitle.i-editor.has_glint",
          "fallback": "Has Glint"
        }
      ],
      "initial": false
    }
  ],
  "can_close_with_escape": true,
  "pause": false,
  "after_action": "none",
  "yes": {
    "label": {
      "translate": "gui.done",
      "color": "green"
    },
    "action": {
      "type": "dynamic/run_command",
      "template": "execute if items entity @s weapon.mainhand * run item modify entity @s weapon.mainhand {\"type\":\"minecraft:set_components\",\"components\":{\"minecraft:enchantment_glint_override\":$(has_glint)}}"
    }
  },
  "no": {
    "label": {
      "translate": "gui.back",
      "color": "red"
    },
    "action": {
      "type": "show_dialog",
      "dialog": "i-editor:set_component"
    }
  }
}