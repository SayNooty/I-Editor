      "label": {
        "translate": "subtitle.i-editor.shadow",
        "fallback": "Shadow",
        "hover_event": {
          "action": "show_text",
          "value": {
            "translate": "description.i-editor.shadow",
            "fallback": "Adds a shadow to the text\nwhen there is a check mark",
            "color": "gray"
          }
        }
      },
      "initial": true,
      "on_true": " ",
      "on_false": "\"shadow_color\":0,"
    },
    {
      "type": "minecraft:boolean",
      "key": "bold",
      "label": {
        "translate": "formatting.i-editor.bold",
        "fallback": "Bold",
        "bold": true
      },
      "initial": false
    },
    {
      "type": "minecraft:boolean",
      "key": "italic",
      "label": {
        "translate": "formatting.i-editor.italic",
        "fallback": "Italic",
        "italic": true
      },
      "initial": false
    },
    {
      "type": "minecraft:boolean",
      "key": "underlined",
