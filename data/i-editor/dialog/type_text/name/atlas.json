    },
    {
      "type": "minecraft:boolean",
      "key": "obfuscated",
      "label": {
        "translate": "formatting.i-editor.obfuscated",
        "fallback": "Obfuscated",
        "obfuscated": true,
        "hover_event": {
          "action": "show_text",
          "value": {
            "translate": "formatting.i-editor.obfuscated",
            "fallback": "Obfuscated",
            "color": "gray"
          }
        }
      },
      "initial": false
    }
