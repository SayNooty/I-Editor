{
  "type": "minecraft:confirmation",
  "title": [
    {
      "translate": "title.i-editor.potion",
      "fallback": "Potion"
    },
    ": ",
    {
      "translate": "effect.minecraft.conduit_power",
      "color": "#1DC2D1"
    }
  ],
  "external_title": [
    {
      "atlas": "minecraft:gui",
      "sprite": "minecraft:mob_effect/conduit_power"
    },
    " ",
    {
    "translate": "effect.minecraft.conduit_power",
    "color": "#1DC2D1"
    }
  ],
  "body": {
    "type": "minecraft:item",
    "item": {
      "id": "minecraft:potion",
      "components": {
        "minecraft:potion_contents": {
          "custom_effects": [
            {
              "id": "minecraft:conduit_power"
            }
          ]
        }
      }
    },
    "description": {
      "translate": "description.i-editor.potion",
      "fallback": "Edit the amplifier, duration, and visualization of the effect of this potion:",
      "color": "gray"
    },
    "show_decorations": false,
    "show_tooltip": false
  },
  "inputs": [
    {
      "type": "minecraft:number_range",
      "key": "amplifier",
      "width": 150,
      "label": {
        "translate": "subtitle.i-editor.amplifier",
        "fallback": "Amplifier"
      },
      "start": 0,
      "end": 255,
      "step": 1,
      "initial": 0
    },
    {
      "type": "minecraft:text",
      "key": "duration",
      "width": 150,
      "label": [
        {
          "translate": "subtitle.i-editor.duration",
          "fallback": "Duration"
        },
        " ",
        {
          "translate": "subtitle.i-editor.in_ticks",
          "fallback": "[in ticks]",
          "color": "gray"
        }
      ],
      "initial": "20",
      "max_length": 10
    },
    {
      "type": "minecraft:boolean",
      "key": "ambient",
      "label": {
        "translate": "subtitle.i-editor.ambient",
        "fallback": "Ambient"
      },
      "initial": true
    },
    {
      "type": "minecraft:boolean",
      "key": "show_particles",
      "label": {
        "translate": "subtitle.i-editor.show_particles",
        "fallback": "Show Particles"
      },
      "initial": true
    },
    {
      "type": "minecraft:boolean",
      "key": "show_icon",
      "label": {
        "translate": "subtitle.i-editor.show_icon",
        "fallback": "Show Icon"
      },
      "initial": true
    }
  ],
  "can_close_with_escape": true,
  "pause": false,
  "after_action": "none",
  "yes": {
    "label": {
      "translate": "gui.done",
      "color": "green"
    },
    "action": {
      "type": "dynamic/run_command",
      "template": "execute if items entity @s weapon.mainhand * run item modify entity @s weapon.mainhand {\"type\":\"minecraft:set_components\",\"components\":{\"minecraft:potion_contents\":{\"custom_effects\":[{\"id\":\"minecraft:conduit_power\",\"amplifier\":$(amplifier),\"duration\":$(duration),\"ambient\":$(ambient),\"show_particles\":$(show_particles),\"show_icon\":$(show_icon)}]}}}"
    }
  },
  "no": {
    "label": {
      "translate": "gui.back",
      "color": "red"
    },
    "action": {
      "type": "minecraft:show_dialog",
      "dialog": "i-editor:set_potion"
    }
  }
}